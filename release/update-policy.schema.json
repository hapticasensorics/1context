{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1context.local/schemas/update-policy.v1.json",
  "title": "1Context Update Policy",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "update_class",
    "approved_by",
    "reason",
    "reason_detail",
    "minimum_autoupdate_version",
    "critical_update_version",
    "ui"
  ],
  "properties": {
    "schema_version": { "const": "1context.update-policy.v1" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "update_class": { "enum": ["mandatory", "optional"] },
    "approved_by": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "reason_detail": { "type": "string", "minLength": 1 },
    "minimum_autoupdate_version": { "type": "string" },
    "minimum_update_version": { "type": "string" },
    "critical_update_version": { "type": "string" },
    "ui": {
      "type": "object",
      "required": [
        "show_release_notes_in_update_window",
        "optional_prompt",
        "failure_message",
        "post_install_message"
      ],
      "properties": {
        "show_release_notes_in_update_window": { "type": "boolean" },
        "optional_prompt": {
          "type": "object",
          "required": ["title", "body"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 }
          }
        },
        "failure_message": {
          "type": "object",
          "required": ["title", "body"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 }
          }
        },
        "post_install_message": {
          "type": "object",
          "required": ["enabled", "title", "body"],
          "properties": {
            "enabled": { "type": "boolean" },
            "title": { "type": "string", "minLength": 1 },
            "body": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
